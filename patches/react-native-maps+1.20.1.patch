@@ -0,0 +1,47 @@
+#import <CoreGraphics/CoreGraphics.h>
+
+// Stroke the compound path into a single nonzero-filled coverage shape. All
+// subpaths are rasterized together, then receive alpha once: repeated trips
+// cannot darken either the interior or antialiased edges. Core Graphics clips
+// this work to MapKit's tile context; no world-sized backing bitmap is created.
+static inline void AIRMapDrawHistoryCoverage(CGContextRef context, CGPathRef path,
+                                             CGFloat width, CGColorRef color, CGFloat opacity) {
+    if (!path || !color || width <= 0 || opacity <= 0) return;
+    CGPathRef coverage = CGPathCreateCopyByStrokingPath(path, NULL, width,
+                                                      kCGLineCapRound, kCGLineJoinRound, 10);
+    CGContextSaveGState(context);
+    CGContextSetAlpha(context, opacity);
+    CGContextSetFillColorWithColor(context, color);
+    CGContextAddPath(context, coverage);
+    CGContextFillPath(context);
+    CGContextRestoreGState(context);
+    CGPathRelease(coverage);
+}
+
+// A clearly legible baseline plus bounded, per-outing brightening. Compound
+// paths make self-overlap and native chunk duplication count only once per trip.
+// Heat affects line ink only; no geographic widening or fog data is involved.
+static inline void AIRMapDrawHistoryHeat(CGContextRef context, CGPathRef combined,
+                                         CGPathRef const *outings, size_t count,
+                                         CGFloat width, CGColorRef base, CGFloat opacity) {
+    if (!combined || !base || width <= 0 || opacity <= 0) return;
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    CGFloat edgeRGBA[] = {0.055, 0.15, 0.12, 1};
+    CGFloat hotRGBA[] = {0.81, 1.0, 0.88, 1};
+    CGColorRef edge = CGColorCreate(space, edgeRGBA);
+    CGColorRef hot = CGColorCreate(space, hotRGBA);
+    CGContextSaveGState(context);
+    CGContextSetAlpha(context, opacity);
+    CGContextBeginTransparencyLayer(context, NULL);
+    AIRMapDrawHistoryCoverage(context, combined, width * 1.5, edge, 0.75);
+    AIRMapDrawHistoryCoverage(context, combined, width, base, 1);
+    for (size_t i = 0; i < count; i++) {
+        // Source-over asymptotically approaches pale mint, never unbounded white.
+        AIRMapDrawHistoryCoverage(context, outings[i], width, hot, 0.16);
+    }
+    CGContextEndTransparencyLayer(context);
+    CGContextRestoreGState(context);
+    CGColorRelease(edge);
+    CGColorRelease(hot);
+    CGColorSpaceRelease(space);
+}
