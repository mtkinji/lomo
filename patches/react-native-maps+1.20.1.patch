+static const NSUInteger AIRMapFogMaximumSegmentCount = 256;
+#define AIRMapFogMaximumPlaceCount 256
+
+typedef struct {
+    vector_float2 viewportSize;
+    vector_float2 noiseOrigin;
+    float mapPointsPerPixel;
+    float time;
+    float clearRadius;
