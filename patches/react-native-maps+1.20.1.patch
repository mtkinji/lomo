@@ -0,0 +1,96 @@
+#import "AIRMapHistoryRenderer.h"
+#import "AIRMapHistoryDrawing.h"
+@implementation AIRMapHistoryRenderer {
+    CGPathRef _historyPath;
+    CGPathRef *_outingPaths;
+    NSUInteger _outingCount;
+    UIColor *_historyColor;
+    CGFloat _historyWidth;
+    CGFloat _historyOpacity;
+}
+- (void)releaseOutingPaths {
+    for (NSUInteger i = 0; i < _outingCount; i++) CGPathRelease(_outingPaths[i]);
+    free(_outingPaths); _outingPaths = NULL; _outingCount = 0;
+}
+- (void)dealloc { if (_historyPath) CGPathRelease(_historyPath); [self releaseOutingPaths]; }
+- (void)updateCoordinates:(NSArray *)coordinates segmentStarts:(NSArray<NSNumber *> *)starts sessionIds:(NSArray<NSNumber *> *)sessionIds {
+    CGMutablePathRef path = CGPathCreateMutable();
+    NSMutableArray<NSNumber *> *validStarts = [NSMutableArray new];
+    NSMutableArray<NSNumber *> *validSessionIds = [NSMutableArray new];
+    NSInteger previous = -1;
+    for (NSUInteger entry = 0; entry < starts.count; entry++) {
+        id value = starts[entry];
+        if (![value isKindOfClass:[NSNumber class]]) continue;
+        double raw = [value doubleValue];
+        if (!isfinite(raw) || raw != floor(raw) || raw < 0 || raw >= coordinates.count || raw <= previous) continue;
+        previous = (NSInteger)raw;
+        [validStarts addObject:@(previous)];
+        id sessionId = entry < sessionIds.count ? sessionIds[entry] : @0;
+        double owner = [sessionId isKindOfClass:[NSNumber class]] ? [sessionId doubleValue] : 0;
+        [validSessionIds addObject:isfinite(owner) && owner >= 0 && owner == floor(owner) ? @(owner) : @0];
+    }
+    CGPathRef *outingPaths = calloc(MAX((NSUInteger)1, validStarts.count), sizeof(CGPathRef));
+    if (!outingPaths) { CGPathRelease(path); return; }
+    NSMutableDictionary<NSNumber *, NSNumber *> *outingIndexes = [NSMutableDictionary new];
+    NSUInteger outingCount = 0;
+    for (NSUInteger segment = 0; segment < validStarts.count; segment++) {
+        NSUInteger start = validStarts[segment].unsignedIntegerValue;
+        NSUInteger end = segment + 1 < validStarts.count ? validStarts[segment + 1].unsignedIntegerValue : coordinates.count;
+        NSNumber *sessionId = validSessionIds[segment];
+        NSNumber *outingIndex = outingIndexes[sessionId];
+        if (!outingIndex) {
+            outingIndex = @(outingCount);
+            outingIndexes[sessionId] = outingIndex;
+            outingPaths[outingCount++] = CGPathCreateMutable();
+        }
+        CGMutablePathRef outing = (CGMutablePathRef)outingPaths[outingIndex.unsignedIntegerValue];
+        BOOL hasPrevious = NO;
+        for (NSUInteger i = start; i < end; i++) {
+            id value = coordinates[i];
+            if (![value isKindOfClass:[NSDictionary class]] ||
+                ![value[@"latitude"] isKindOfClass:[NSNumber class]] ||
+                ![value[@"longitude"] isKindOfClass:[NSNumber class]]) { hasPrevious = NO; continue; }
+            CLLocationCoordinate2D coordinate = CLLocationCoordinate2DMake([value[@"latitude"] doubleValue], [value[@"longitude"] doubleValue]);
+            if (!isfinite(coordinate.latitude) || !isfinite(coordinate.longitude) || !CLLocationCoordinate2DIsValid(coordinate)) { hasPrevious = NO; continue; }
+            CGPoint point = [self pointForMapPoint:MKMapPointForCoordinate(coordinate)];
+            if (!hasPrevious) {
+                CGPathMoveToPoint(path, NULL, point.x, point.y);
+                CGPathMoveToPoint(outing, NULL, point.x, point.y);
+            } else {
+                CGPathAddLineToPoint(path, NULL, point.x, point.y);
+                CGPathAddLineToPoint(outing, NULL, point.x, point.y);
+            }
+            hasPrevious = YES;
+        }
+    }
+    @synchronized (self) {
+        if (_historyPath) CGPathRelease(_historyPath);
+        _historyPath = path;
+        [self releaseOutingPaths];
+        _outingPaths = outingPaths;
+        _outingCount = outingCount;
+    }
+    [self setNeedsDisplay];
+}
+- (void)updateColor:(UIColor *)color width:(CGFloat)width opacity:(CGFloat)opacity {
+    @synchronized (self) {
+        _historyColor = color;
+        _historyWidth = isfinite(width) ? MAX(0, MIN(32, width)) : 0;
+        _historyOpacity = isfinite(opacity) ? MAX(0, MIN(1, opacity)) : 0;
+    }
+    [self setNeedsDisplay];
+}
+- (void)drawMapRect:(MKMapRect)mapRect zoomScale:(MKZoomScale)zoomScale inContext:(CGContextRef)context {
+    if (zoomScale <= 0) return;
+    @synchronized (self) {
+        if (!_historyPath || !_historyColor || _historyOpacity <= 0) return;
+        CGRect tile = [self rectForMapRect:mapRect];
+        CGFloat width = _historyWidth / zoomScale;
+        if (!CGRectIntersectsRect(CGRectInset(CGPathGetPathBoundingBox(_historyPath), -width, -width), tile)) return;
+        CGContextSaveGState(context);
+        CGContextClipToRect(context, tile);
+        AIRMapDrawHistoryHeat(context, _historyPath, _outingPaths, _outingCount, width, _historyColor.CGColor, _historyOpacity);
+        CGContextRestoreGState(context);
+    }
+}
+@end
