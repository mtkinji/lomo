#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
push_updates="$(mktemp "${TMPDIR:-/tmp}/kwilt-pre-push.XXXXXX")"
trap 'rm -f "$push_updates"' EXIT
cat > "$push_updates"

command -v git-lfs >/dev/null 2>&1 || {
  printf >&2 '\n%s\n\n' "This repository uses Git LFS but 'git-lfs' was not found on your path."
  exit 2
}

node "$repo_root/scripts/verify-push.mjs" "${1:-origin}" < "$push_updates"
git lfs pre-push "$@" < "$push_updates"
