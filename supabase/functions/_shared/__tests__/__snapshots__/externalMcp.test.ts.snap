              "enum": [
                1,
                2,
                3,
                null,
              ],
              "type": [
                "integer",
                "null",
              ],
            },
            "reminderAt": {
              "format": "date-time",
              "type": [
                "string",
                "null",
              ],
            },
            "repeatBasis": {
              "enum": [
                "scheduled",
                "after_completion",
                null,
              ],
              "type": [
                "string",
                "null",
