{
  "name": "kwilt",
  "version": "1.0.105",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "start:clean": "bash scripts/kill-expo.sh && expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ios:build:production": "eas build --platform ios --profile production --non-interactive",
    "ios:submit:production": "eas submit --platform ios --profile production --non-interactive",
    "ios:testflight": "eas build --platform ios --profile production-widgets --non-interactive --auto-submit",
    "ios:testflight:no-widgets": "eas build --platform ios --profile production --non-interactive --auto-submit",
    "lint": "tsc --noEmit",
    "lint:tests": "tsc --noEmit --project tsconfig.test.json",
    "verify:changed": "node scripts/verify-changed.mjs",
    "code:health": "node scripts/code-health.mjs",
    "test:code-health": "node --test scripts/code-health-lib.test.mjs",
    "architecture:lint": "node --test scripts/architecture-lint-lib.test.mjs && node scripts/architecture-lint.mjs",
    "audio:audit": "node scripts/audio/audit-assets.mjs",
    "audio:audit:loops": "node scripts/audio/audit-loop-seams.mjs",
    "audio:audit:soundscape-contract": "node scripts/audio/soundscape-loop-contract.mjs",
    "audio:probe:rendered-loop": "node scripts/audio/rendered-loop-probe.mjs",
    "audio:master:loop": "node scripts/audio/master-loop.mjs",
    "audio:build:pattern-grooves": "node scripts/audio/build-pattern-grooves.mjs",
    "audio:audit:enforce": "node scripts/audio/audit-assets.mjs --enforce",
    "audio:normalize": "node scripts/audio/normalize-assets.mjs",
    "test:audio-tooling": "node --test scripts/audio/audio-audit-lib.test.mjs",
    "agent:map": "node scripts/generate-agent-code-map.mjs",
    "food:feasibility": "node scripts/food-provider-feasibility.mjs",
    "food:import-corpus": "node scripts/food-recipe-import-corpus.mjs",
    "test:food-feasibility": "node --test scripts/food-feasibility.test.mjs",
    "lint:supabase-functions": "find supabase/functions -path 'supabase/functions/node_modules' -prune -o -name '*.ts' ! -path '*/__tests__/*' -print0 | xargs -0 deno check --no-lock --config supabase/functions/tsconfig.json",
    "test:supabase-functions": "deno test --no-lock --config supabase/functions/tsconfig.json supabase/functions/chapters-generate/__tests__/*_deno_test.ts supabase/functions/create-plaid-link-token/__tests__/*_deno_test.ts supabase/functions/heart-report/__tests__/heartReport_deno_test.ts supabase/functions/_shared/__tests__/goalSupport_deno_test.ts supabase/functions/_shared/__tests__/sharedHomeDelivery_deno_test.ts supabase/functions/shared-home-publish-goal-checkin/publishGoalCheckin_deno_test.ts supabase/functions/_shared/__tests__/unifiedChatTranscription_deno_test.ts supabase/functions/_shared/__tests__/liveConversationSession_deno_test.ts supabase/functions/_shared/__tests__/cookVoiceSpeech_deno_test.ts supabase/functions/_shared/__tests__/moneyTransactionClassifier_deno_test.ts supabase/functions/classify-money-transactions/__tests__/classificationPolicy_deno_test.ts supabase/functions/_shared/__tests__/recipeImport_deno_test.ts supabase/functions/_shared/__tests__/recipeImageAdmin_deno_test.ts supabase/functions/_shared/__tests__/recipeImagePipeline_deno_test.ts supabase/functions/_shared/__tests__/mealPlanningDelivery_deno_test.ts supabase/functions/_shared/__tests__/groceryCompiler_deno_test.ts supabase/functions/_shared/__tests__/groceryRetailerAdapters_deno_test.ts supabase/functions/_shared/__tests__/groceryRetailerCart_deno_test.ts supabase/functions/_shared/__tests__/krogerShoppingLocation_deno_test.ts supabase/functions/_shared/__tests__/krogerAdapter_deno_test.ts supabase/functions/_shared/__tests__/krogerAuthState_deno_test.ts supabase/functions/_shared/__tests__/grocerySavings_deno_test.ts",
    "recipe-images:pilot": "node scripts/recipe-images/pipeline.mjs",
    "recipe-images:review": "node scripts/recipe-images/review-sheet.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "storybook:web": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "mcp:e2e": "node scripts/mcp-all-tools-e2e.mjs",
    "visual:collect": "node scripts/visual-regression/collect.js",
    "visual:compare": "node scripts/visual-regression/compare.js",
    "visual:update": "node scripts/visual-regression/compare.js --update",
    "chat:delivery-lint": "node scripts/chat-delivery-lint.mjs",
    "money:transaction-truth:evidence": "node scripts/money-transaction-truth-evidence-check.mjs",
    "test:money-transaction-truth:evidence": "node --test scripts/money-transaction-truth-evidence.test.mjs",
    "chat:protocol:conformance": "node scripts/unified-chat-protocol-conformance.mjs",
    "chat:live-eval": "tsx scripts/unified-chat-live-eval.ts",
    "test:chat-contracts": "node --test scripts/chat-delivery-lint.test.mjs scripts/unified-chat-migration-contract.test.mjs && npm run chat:protocol:conformance",
    "product:lint": "node scripts/product-lint.mjs && npm run chat:delivery-lint",
    "jtbd:lint": "npm run product:lint",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^14.0.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "@kwilt/arc-survey": "workspace:*",
    "@react-native-aria/focus": "^0.2.9",
    "@react-native-aria/interactions": "^0.2.16",
    "@react-native-aria/overlays": "^0.3.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/drawer": "^7.13.5",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/portal": "^1.5.2",
    "@supabase/supabase-js": "^2.112.0",
    "expo": "^55.0.28",
    "expo-application": "~55.0.17",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-auth-session": "~55.0.17",
    "expo-background-task": "~55.0.20",
    "expo-blur": "~55.0.16",
    "expo-calendar": "~55.0.17",
    "expo-clipboard": "~55.0.15",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image-picker": "~55.0.22",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.16",
    "expo-local-authentication": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-location": "~55.1.12",
    "expo-notifications": "~55.0.25",
    "expo-screen-orientation": "~55.0.18",
    "expo-sensors": "~55.0.17",
    "expo-speech": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-task-manager": "~55.0.18",
    "expo-video": "~55.0.19",
    "expo-web-browser": "~55.0.18",
    "lucide-react-native": "^0.553.0",
    "posthog-react-native": "^4.61.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-is-edge-to-edge": "^1.2.1",
    "react-native-maps": "1.20.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.35.5",
    "react-native-pell-rich-editor": "^1.9.0",
    "react-native-plaid-link-sdk": "13.0.3",
    "react-native-purchases": "^9.15.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@storybook/react-native-web-vite": "10.5.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "baseline-browser-mapping": "^2.11.12",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "https-proxy-agent": "^7.0.6",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "jsonwebtoken": "^9.0.3",
    "music-metadata": "^11.14.0",
    "patch-package": "8.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react-native-web": "0.21.2",
    "storybook": "10.5.6",
    "typescript": "~5.9.2",
    "vite": "8.2.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-maps"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "kwilt-nearby-table",
          "kwilt-place-search",
          "kwilt-route-reconstruction",
          "kwilt-seamless-loop",
          "react-native-plaid-link-sdk"
        ]
      }
    }
  },
  "overrides": {
    "react-native-windows": "0.83.2",
    "react-native-markdown-display": {
      "markdown-it": "14.2.0"
    }
  },
  "private": true
}
