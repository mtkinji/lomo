{
  "version": 1,
  "operations": [
    {
      "id": "activities.capture",
      "actionModule": "src/capabilities/todos/actions/todoActions.ts",
      "protectedFiles": [
        {
          "path": "src/features/activities/useQuickAddDockController.ts",
          "forbiddenPatterns": [
            {
              "pattern": "addActivity\\(activity\\)",
              "message": "native Quick Add must call createTodo through commitQuickAddTodo"
            }
          ]
        },
        {
          "path": "src/features/unifiedChat/activityProposalExecutor.ts",
          "forbiddenPatterns": [
            {
              "pattern": "store\\.addActivity\\(",
              "message": "Chat create must call the To-do capability action"
            }
          ]
        }
      ]
    },
    {
      "id": "activities.update.completion",
      "actionModule": "src/capabilities/todos/actions/todoActions.ts",
      "protectedFiles": [
        {
          "path": "src/features/plan/ActivityEventPeek.tsx",
          "forbiddenPatterns": [
            {
              "pattern": "applyPlanActivityCompletionAction\\(prev",
              "message": "Plan completion must call performPlanActivityCompletionAction"
            }
          ]
        },
        {
          "path": "src/features/unifiedChat/activityProposalExecutor.ts",
          "forbiddenPatterns": [
            {
              "pattern": "store\\.updateActivity\\(",
              "message": "Chat updates must call the To-do capability action"
            }
          ]
        }
      ]
    },
    {
      "id": "activities.delete",
      "actionModule": "src/capabilities/todos/actions/todoActions.ts",
      "protectedFiles": [
        {
          "path": "src/features/activities/ActivityDetailScreen.tsx",
          "forbiddenPatterns": [
            {
              "pattern": "removeActivity\\(activity\\.id\\)",
              "message": "reviewed native delete must call deleteTodo"
            }
          ]
        },
        {
          "path": "src/features/unifiedChat/activityProposalExecutor.ts",
          "forbiddenPatterns": [
            {
              "pattern": "store\\.removeActivity\\(",
              "message": "Chat delete must call the To-do capability action"
            }
          ]
        }
      ]
    },
    {
      "id": "arcs.create",
      "actionModule": "src/capabilities/life-structure/actions/arcActions.ts",
      "protectedFiles": [
        {
          "path": "src/features/arcs/ArcsScreen.tsx",
          "forbiddenPatterns": [
            {
              "pattern": "useAppStore\\(\\(state\\) => state\\.addArc\\)",
              "message": "native Arc creation must call createArc"
            }
          ]
        },
        {
          "path": "src/features/unifiedChat/arcProposalExecutor.ts",
          "forbiddenPatterns": [
            {
              "pattern": "store\\.addArc\\(",
              "message": "Chat Arc creation must call the Arc capability action"
            }
          ]
        }
      ]
    },
    {
      "id": "arcs.update",
      "actionModule": "src/capabilities/life-structure/actions/arcActions.ts",
      "protectedFiles": [
        {
          "path": "src/features/arcs/ArcDetailScreen.tsx",
          "forbiddenPatterns": [
            {
              "pattern": "useAppStore\\(\\(state\\) => state\\.updateArc\\)",
              "message": "native Arc updates must call updateArc"
            }
          ]
        },
        {
          "path": "src/features/unifiedChat/arcProposalExecutor.ts",
          "forbiddenPatterns": [
            {
              "pattern": "store\\.updateArc\\(",
              "message": "Chat Arc updates must call the Arc capability action"
            }
          ]
        }
      ]
    },
    {
      "id": "arcs.delete",
      "actionModule": "src/capabilities/life-structure/actions/arcActions.ts",
      "protectedFiles": [
        {
          "path": "src/features/arcs/ArcDetailScreen.tsx",
          "forbiddenPatterns": [
            {
              "pattern": "useAppStore\\(\\(state\\) => state\\.removeArc\\)",
              "message": "reviewed native Arc delete must call deleteArc"
            }
          ]
        },
        {
          "path": "src/features/unifiedChat/arcProposalExecutor.ts",
          "forbiddenPatterns": [
            {
              "pattern": "store\\.removeArc\\(",
              "message": "Chat Arc delete must call the Arc capability action"
            }
          ]
        }
      ]
    }
  ]
}
