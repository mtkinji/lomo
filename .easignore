# EAS upload ignore rules.
#
# This file takes precedence over .gitignore. Keep repository-local files,
# generated evidence, build outputs, and credential material represented here.

# Git history (not needed by EAS Build).
# EAS CLI checks the literal `.git` path when deleting its shallow clone.
.git

# Local editor and parallel-checkout state (never part of an app build).
.cursor/
.worktrees/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native generated folders (we generate them during EAS prebuild)
/ios
/android
.kotlin/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local EAS logs / artifacts
eas_logs_local/
eas_cloud_logs/
modules/*/android/build/

# generated review, prototype, and store-presentation artifacts
/artifacts/
/prototypes/
app-store-screenshots/

# macOS
.DS_Store

# local scripts / notebooks
JWT Key Generator
notes.ipynb

# product docs / agent-only manifests
docs/
src/features/*/FEATURE.md

# local env files
.env
.env*.local

# credential material; store-build profiles use EAS remote credentials
credentials.json
*.jks
*.key
*.mobileprovision
*.p12
*.p8
*.pem

# typescript
*.tsbuildinfo
